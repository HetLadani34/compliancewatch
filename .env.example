# ============================================================
# ComplianceWatch — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to source control.
#
# How to get a FREE Gemini API Key:
#   1. Visit https://aistudio.google.com/app/apikey
#   2. Sign in with your Google account
#   3. Click "Create API Key" → select a Google Cloud project
#   4. Copy the key and paste it below
# ============================================================

# --- REQUIRED ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Database (leave defaults for local SQLite) ---
DATABASE_URL=sqlite+aiosqlite:///data/compliance_watch.db

# --- ChromaDB Vector Store ---
CHROMA_PERSIST_DIR=data/chroma_db

# --- Screenshot Storage ---
SCREENSHOT_DIR=data/screenshots

# --- Service Ports ---
MOCK_SERVER_PORT=8100
API_PORT=8000

# --- Agent Tuning ---
# Cosine distance above this threshold triggers vision analysis (0.0–1.0)
COSINE_DRIFT_THRESHOLD=0.30
# How often the background scan job runs (seconds)
SCAN_INTERVAL_SECONDS=300

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=data/compliance_watch.log
